  "selection": "Five whole v0.4.6 settings files (DarkThemeSchedule, ThemeStylePalettePreview, ThemeHomePreview, DarkThemeSchedulePreference, ThemeTimeWheelPicker) plus the upstream DarkThemeScheduleTest.",
  "purpose": "Emit the palette style swatch, the home preview, the dark theme schedule model, its preference rows and the wheel time picker from the existing appearance producer. Three files are emitted verbatim; ThemeHomePreview.kt replaces its Android drawable ids with the existing settings vector symbols (three hunks) and ThemeTimeWheelPicker.kt replaces the Android uptime clock with the existing Windows monotonic clock (two hunks). SeedPresetColors.kt and ThemePresetPalettePreview.kt are not repeated: the v0.4.2 copies in v042-seed-palette are byte-identical to v0.4.6.",
  "windowsEmission": {
    "DarkThemeSchedule.kt": "whole original",
    "ThemeStylePalettePreview.kt": "whole original",
    "DarkThemeSchedulePreference.kt": "whole original",
    "ThemeHomePreview.kt": "whole original with 3 counted hunks (R import and two drawable ids)",
    "ThemeTimeWheelPicker.kt": "whole original with 2 counted hunks (SystemClock import and call)",
    "DarkThemeScheduleTest.kt": "whole original test"
  },
  "notCarried": [
    "app/src/main/java/com/android/purebilibili/core/theme/ScheduledDarkThemeObserver.kt (Android broadcast receiver; Windows owns a minute timer in DesktopScheduledDarkTheme.kt)",
    "app/src/androidTest/java/com/Android/purebilibili/feature/settings/ThemeTimeWheelPickerTest.kt (instrumented Android test)",
    "app/src/main/java/com/android/purebilibili/feature/settings/screen/AppearanceSettingsScreen.kt (phone settings page; Windows keeps DesktopAppearanceSettings)"
  ]
