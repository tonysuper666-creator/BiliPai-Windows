  "adaptations": [
    {
      "label": "Original two-key Bundle omission/base merge/cover trim maps primitive typed CID+cover fields, without a second route schema",
      "before": "    return Bundle().apply {\n        if (base != null) {\n            putAll(base)\n        }\n        if (targetCid > 0L) {\n            putLong(VIDEO_NAV_TARGET_CID_KEY, targetCid)\n        }\n        if (normalizedCover.isNotEmpty()) {\n            putString(VIDEO_NAV_COVER_URL_KEY, normalizedCover)\n        }\n    }",
      "after": "    return Pair(\n        if (targetCid > 0L) targetCid else base?.first ?: 0L,\n        if (normalizedCover.isNotEmpty()) normalizedCover else base?.second\n    )"
    },
    {
      "label": "Existing BGM skeleton producer remains sole owner of the exact original cover constant",
      "before": "internal const val RELATED_VIDEO_CARD_COVER_ASPECT_RATIO = 16f / 10f\n",
      "after": ""
