  "paletteChanges": [
    "package rename to com.bilipai.desktop.palette",
    "Android ARGB bit/channel binding",
    "Original ColorCutQuantizer whole algorithm; compile-time false timing branches removed",
    "Original Swatch RGB/HSL/population and Filter; original ColorUtils RGBToHSL/colorToHSL/HSLToColor and constrain methods",
    "Skia borrowed bitmap pixels + nearest pixel-center resize binding; original area/ceil dimensions and useful-largest-swatch policy",
    "128-entry synchronized access-LRU; cancellation before publication and Main callback; no Android SDK or recycled hardware bitmap facades"
  ],
  "licenses": "Original Apache-2.0 notices retained; full license and official Haze POM/module included",
  "capabilityBoundary": "No Android wallpaper/RenderEffect API emulation. Haze JVM binary dependency is the original alpha03 pin; no blur/wallpaper host or shared-navigation transition acceptance claimed."
