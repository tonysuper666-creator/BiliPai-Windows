+/** The Section's actual cover animation and feedback host. Keeping the content slot
+ * here lets a windowless scene exercise the production transition without loading
+ * a native player or constructing another playback owner. */
+@Composable
+internal fun BoxScope.VideoPlayerCoverFeedback(
+    playbackIdentity: String,
+    visible: Boolean,
+    showCover: Boolean,
+    keepCoverForManualStart: Boolean,
+    suppressTransientOverlaysForTransition: Boolean,
+    forceCoverDuringReturnAnimation: Boolean,
+    isInPipMode: Boolean,
+    isPortraitFullscreen: Boolean,
+    mediaKey: String?,
+    fullscreen: Boolean,
+    controlsVisible: Boolean,
+    enter: EnterTransition,
+    exit: ExitTransition,
+    modifier: Modifier = Modifier,
+    content: @Composable androidx.compose.animation.AnimatedVisibilityScope.() -> Unit,
+): androidx.compose.animation.core.MutableTransitionState<Boolean> {
+    val coverVisibility = remember(playbackIdentity) {
+        androidx.compose.animation.core.MutableTransitionState(visible)
+    }
+    coverVisibility.targetState = visible
+    // Match the original AnimatedVisibility overload (no BoxScope receiver).
+    androidx.compose.animation.AnimatedVisibility(
+        visibleState = coverVisibility,
+        enter = enter,
+        exit = exit,
+        modifier = modifier,
+        content = content,
+    )
+    PlaybackResumeFeedback(
+        mediaKey = mediaKey,
+        ready = !keepCoverForManualStart && !showCover &&
+            coverVisibility.isIdle && !coverVisibility.currentState && !coverVisibility.targetState &&
+            !suppressTransientOverlaysForTransition && !forceCoverDuringReturnAnimation &&
+            !isInPipMode && !isPortraitFullscreen,
+        fullscreen = fullscreen,
+        controlsVisible = controlsVisible,
+    )
+    return coverVisibility
+}
+
+/** Presentational part of the real Section input. Native player/action ports are
+ * deliberately absent: consuming cover feedback never acquires playback resources. */
+internal data class VideoPlayerSectionPresentationState(
+    val uiState: VideoPlaybackUiState,
+    val isFullscreen: Boolean,
+    val isInPipMode: Boolean,
+    val isPortraitFullscreen: Boolean,
+    val suppressTransientOverlaysForTransition: Boolean,
+)
+
+internal typealias VideoPlayerSectionRenderer = @Composable (
+    VideoPlayerSectionPresentationState,
+    () -> VideoPlayerSectionState,
+    () -> VideoPlayerSectionActions,
+) -> Unit
+
+/** The actual Section state-to-feedback call, shared with a windowless renderer. */
+@Composable
+internal fun BoxScope.VideoPlayerSectionCoverFeedback(
+    state: VideoPlayerSectionPresentationState,
+    playbackIdentity: String,
+    visible: Boolean,
+    showCover: Boolean,
+    keepCoverForManualStart: Boolean,
+    forceCoverDuringReturnAnimation: Boolean,
+    controlsVisible: Boolean,
+    enter: EnterTransition,
+    exit: ExitTransition,
+    modifier: Modifier = Modifier,
+    content: @Composable androidx.compose.animation.AnimatedVisibilityScope.() -> Unit,
+): androidx.compose.animation.core.MutableTransitionState<Boolean> = VideoPlayerCoverFeedback(
+    playbackIdentity = playbackIdentity,
+    visible = visible,
+    showCover = showCover,
+    keepCoverForManualStart = keepCoverForManualStart,
+    suppressTransientOverlaysForTransition = state.suppressTransientOverlaysForTransition,
+    forceCoverDuringReturnAnimation = forceCoverDuringReturnAnimation,
+    isInPipMode = state.isInPipMode,
+    isPortraitFullscreen = state.isPortraitFullscreen,
+    mediaKey = (state.uiState as? VideoPlaybackUiState.Success)?.info?.let { "${it.bvid}:${it.cid}" },
+    fullscreen = state.isFullscreen,
+    controlsVisible = controlsVisible,
+    enter = enter,
+    exit = exit,
+    modifier = modifier,
+    content = content,
+)
