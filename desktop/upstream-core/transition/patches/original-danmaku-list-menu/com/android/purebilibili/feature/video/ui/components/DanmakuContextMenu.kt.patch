+/** 可退役：完整 ContextMenu 迁入后由其原文替代；仅详细入口可收集说明。 */
+@Composable
+internal fun DanmakuContextReportContent(
+    canBlockUser: Boolean,
+    onReportWithExplanation: ((Int, String, Boolean) -> Unit)?,
+    onReport: (Int) -> Unit,
+    onDismiss: () -> Unit,
+    onBack: () -> Unit,
+) {
+    if (onReportWithExplanation != null) {
+        Column(Modifier.width(300.dp).background(MaterialTheme.colorScheme.surface).padding(12.dp)) {
+            com.android.purebilibili.core.ui.components.AppTextButton(onClick = onBack) { AppText("返回") }
+            DanmakuReportForm(canBlockUser = canBlockUser, onSubmit = { reason, explanation, block ->
+                onReportWithExplanation(reason, explanation, block)
+                onDismiss()
+            })
+        }
+    } else ReportReasonMenu(
+        onSelectReason = { reason -> onReport(reason); onDismiss() },
+        onBack = onBack,
+    )
+}
