+/** Same provider used by the retained Holder; the slot needs no native resources. */
+@Composable
+internal fun VideoDetailPlaybackFeedbackProvider(
+    state: VideoDetailPlaybackEventState,
+    content: @Composable () -> Unit,
+) {
+    androidx.compose.runtime.CompositionLocalProvider(
+        LocalPlaybackResumeFeedback provides state,
+        content = content,
     )
 }
