+    private fun iconKeys(expression: String): List<String> {
+        val normalized = expression.replace(Regex("""\s+"""), "")
+        if (!normalized.startsWith("rememberThemeAwareSettingsIcon(")) return listOf(normalized)
+        val material = Regex("""materialSymbolResource=([\w.]+)""").find(normalized)?.groupValues?.get(1)
+        val miuix = Regex("""miuixIcon=([\w.]+)""").find(normalized)?.groupValues?.get(1)
+        require(material != null && miuix != null) { "Unrecognized theme-aware icon: $expression" }
+        return listOf("material:$material", "miuix:$miuix")
+    }
+
