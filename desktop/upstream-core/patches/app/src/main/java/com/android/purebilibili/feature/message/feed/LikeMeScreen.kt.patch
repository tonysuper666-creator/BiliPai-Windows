 private fun mergeLikeItems(
     existing: List<MessageFeedLikeItem>,
     incoming: List<MessageFeedLikeItem>
 ): List<MessageFeedLikeItem> {
     val seen = linkedSetOf<Long>()
     return buildList {
         (existing + incoming).forEach { item ->
             if (seen.add(item.id)) add(item)
         }
     }
 }
 
