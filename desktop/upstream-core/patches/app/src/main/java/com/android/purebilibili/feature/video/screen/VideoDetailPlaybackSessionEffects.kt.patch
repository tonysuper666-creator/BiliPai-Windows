+/** The production subject observer also clears a pending notice on same-video part
+ * changes. Keep the BVID-scoped event container and retained danmaku port intact. */
+@Composable
+internal fun VideoDetailResumeIdentityEffect(
+    subjectSnapshot: StateFlow<VideoSubjectSnapshot?>,
+    state: VideoDetailPlaybackEventState,
+) {
+    LaunchedEffect(subjectSnapshot, state, "resume-identity") {
+        subjectSnapshot.collect { subject ->
+            val pending = state.resumeMessage
+            if (subject != null && pending != null &&
+                pending.mediaKey != "${subject.bvid}:${subject.cid}"
+            ) {
+                state.resumeMessage = null
+                state.resumeMessageDeadlineMs = null
+            }
+        }
+    }
+}
