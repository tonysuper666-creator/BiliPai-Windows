+
+// Desktop compatibility: legacy two-argument report callers cannot carry explanations.
+private val MenuBackground = Color(0xCC1C1C1E)
+private val PrimaryColor = Color(0xFF0A84FF)
+internal val DanmakuReportReasons: List<Pair<String, Int>> = listOf(
+    "违法违禁" to 1,
+    "色情低俗" to 2,
+    "赌博诈骗" to 3,
+    "引战" to 4,
+    "人身攻击" to 5,
+    "剧透" to 6,
+    "刷屏" to 7,
+    "其他" to 8
+)
+
+@Composable
+private fun ReportReasonMenu(
+    onSelectReason: (Int) -> Unit,
+    onBack: () -> Unit
+) {
+    Column(
+        modifier = Modifier
+            .width(280.dp)
+            .clip(AppShapes.container(ContainerLevel.Dialog))
+            .background(MenuBackground),
+        horizontalAlignment = Alignment.CenterHorizontally
+    ) {
+        // Header with Back
+        Box(
+            modifier = Modifier
+                .fillMaxWidth()
+                .padding(12.dp)
+        ) {
+            AppIconButton(
+                onClick = onBack,
+                modifier = Modifier.align(Alignment.CenterStart),
+            ) {
+                AppIcon(
+                    imageVector = Icons.AutoMirrored.Filled.ArrowBack,
+                    contentDescription = "返回",
+                    tint = PrimaryColor,
+                    modifier = Modifier.size(24.dp),
+                )
+            }
+            AppText(
+                text = "举报原因",
+                color = Color.White,
+                style = MaterialTheme.typography.titleMedium.copy(fontWeight = FontWeight.SemiBold),
+                modifier = Modifier.align(Alignment.Center)
+            )
+        }
+
+        MenuSeparator()
+
+        val reasons = DanmakuReportReasons
+
+        reasons.forEachIndexed { index, (label, code) ->
+            MenuItem(
+                label = label,
+                centered = true, // Center text for options
+                onClick = { onSelectReason(code) }
+            )
+            if (index < reasons.lastIndex) {
+                MenuSeparator()
+            }
+        }
+    }
+}
+
+@Composable
+internal fun DanmakuContextReportContent(
+    canBlockUser: Boolean,
+    onReportWithExplanation: ((Int, String, Boolean) -> Unit)?,
+    onReport: (Int) -> Unit,
+    onDismiss: () -> Unit,
+    onBack: () -> Unit,
+) {
+    if (onReportWithExplanation != null) {
+        Column(Modifier.width(300.dp).background(MaterialTheme.colorScheme.surface).padding(12.dp)) {
+            com.android.purebilibili.core.ui.components.AppTextButton(onClick = onBack) { AppText("返回") }
+            DanmakuReportForm(canBlockUser = canBlockUser, onSubmit = { reason, explanation, block ->
+                onReportWithExplanation(reason, explanation, block)
+                onDismiss()
+            })
+        }
+    } else ReportReasonMenu(
+        onSelectReason = { reason -> onReport(reason); onDismiss() },
+        onBack = onBack,
+    )
+}
