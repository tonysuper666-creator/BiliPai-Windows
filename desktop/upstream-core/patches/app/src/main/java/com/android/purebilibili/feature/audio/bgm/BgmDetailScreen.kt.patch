+/** The composer's close and send decisions for one composer session. A callback captured by an older session or reply
+ * target does nothing: the comment state is read when it runs, not when it was created. */
+internal class BgmComposerCallbacks(
+    private val comments: VideoCommentViewModel,
+    private val sessionId: Long,
+    private val replyRpid: Long?,
+    private val isComposerOpen: () -> Boolean,
+    private val closeComposer: () -> Unit,
+    private val markSubmitted: (Long) -> Unit,
+) {
+    fun onDismiss() {
+        if (comments.commentState.value.composerDrafts.sessionId == sessionId) {
+            closeComposer()
+            comments.cancelReply()
+        }
+    }
+
+    fun onSend(text: String, images: List<String>, sync: Boolean) {
+        val latest = comments.commentState.value
+        if (isComposerOpen() && latest.composerDrafts.sessionId == sessionId &&
+            latest.composerDrafts.completedSessionId != sessionId &&
+            latest.replyTarget?.rpid == replyRpid && !latest.isSending
+        ) {
+            markSubmitted(sessionId)
+            comments.updateCommentDraft(sessionId, replyRpid, text, images, sync)
+            comments.sendComment(text, images, sync)
+        }
+    }
+}
